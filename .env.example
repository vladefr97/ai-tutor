# Скопируйте в .env. Значения секретов не коммитятся.
OPENAI_API_KEY=
# Аккаунт преподавателя создаётся при старте
ADMIN_EMAIL=teacher@example.com
# Соль для хешей кодов и сессий; в локальном запуске по умолчанию local-dev-pepper
AUTH_PEPPER=
# Время жизни одноразового кода и сессии (Go duration)
AUTH_CODE_TTL=10m
SESSION_TTL=720h

# GitHub: заполняет scripts/setup-github.sh, проверка — go run ./backend/cmd/ghcheck
# Организация платформы для учебных репозиториев
GITHUB_ORG=
# GitHub App: ID и короткое имя (github.com/apps/<slug>)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Приватный ключ App (.pem); каталог .secrets/ не коммитится
GITHUB_APP_PRIVATE_KEY_PATH=.secrets/github-app.pem
# OAuth той же App для подключения аккаунта ученика
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Подпись вебхуков (X-Hub-Signature-256) и канал smee.io для доставки на localhost
GITHUB_WEBHOOK_SECRET=
SMEE_URL=
# Два тестовых аккаунта учеников для live-проверок изоляции репозиториев
GITHUB_TEST_LEARNER_A=
GITHUB_TEST_LEARNER_B=
