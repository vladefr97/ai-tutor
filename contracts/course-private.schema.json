{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutor-app.local/contracts/course-private.schema.json",
  "title": "Служебная часть версии курса",
  "description": "Ключи ответов, подсказки, разборы, критерии зачёта и ссылки на официальные проверки. Никогда не отдаётся браузеру и не попадает в папку Учебного наставника. Ключи объектов — ID из публичной части.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "questions", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "questions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "correct": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "criteria": { "$ref": "#/$defs/criteria" },
          "hint": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criteria"],
        "properties": {
          "criteria": { "$ref": "#/$defs/criteria" },
          "officialChecks": {
            "description": "Каталог официальных тестов внутри служебной части версии, например checks/sum-function",
            "type": "string",
            "pattern": "^checks/[a-z0-9][a-z0-9_./-]*$",
            "not": { "pattern": "\\.\\." }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
