     }
    }
   ]
  },
  {
   "id": 6,
   "title": "HTTP: задержка p50, p95, p99 по классу кода",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, class) (label_replace(rate(http_request_duration_seconds_bucket[5m]), \"class\", \"${1}xx\", \"code\", \"(.).*\")))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, class) (label_replace(rate(http_request_duration_seconds_bucket[5m]), \"class\", \"${1}xx\", \"code\", \"(.).*\")))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, class) (label_replace(rate(http_request_duration_seconds_bucket[5m]), \"class\", \"${1}xx\", \"code\", \"(.).*\")))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
